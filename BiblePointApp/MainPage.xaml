<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BiblePointApp.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" HorizontalOptions="Center" VerticalOptions="Center">

            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Button x:Name="LanguageToggleButton"
                        Text="언어 변경 (EN/KR)"
                        Clicked="OnToggleLanguageClicked"
                        BackgroundColor="#666666"
                        TextColor="White"
                        CornerRadius="20"
                        Padding="15,5"/>

                <Button Text="🔍 검색하기"
                        Clicked="OnSearchButtonClicked"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="20"
                        Padding="15,5"/>
            </HorizontalStackLayout>

            <Label x:Name="MainTitleLabel"
                   Text="성경 필사 포인트"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,40,0,20"/>

            <Button x:Name="StartWritingButton"
                    Text="새 필사 시작하기"
                    Clicked="OnStartNewWritingClicked"
                    HeightRequest="60"
                    WidthRequest="320"
                    BackgroundColor="#9c27b0"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" WidthRequest="320">
                <Button x:Name="ResumeButton"
                        Grid.Column="0"
                        Text="이어 쓰기"
                        Clicked="OnResumeWritingClicked"
                        HeightRequest="60"
                        BackgroundColor="#3f51b5"
                        TextColor="White"
                        FontSize="16"
                        CornerRadius="10"/>

                <Button x:Name="MemoryBookButton"
                        Grid.Column="1"
                        Text="나의 암기장"
                        Clicked="OnMemoryBookClicked"
                        HeightRequest="60"
                        BackgroundColor="#ff80ab"
                        TextColor="Black"
                        FontSize="16"
                        CornerRadius="10"/>
            </Grid>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" WidthRequest="320">
                <Button x:Name="BookmarkButton"
                        Grid.Column="0"
                        Text="책갈피"
                        Clicked="OnBookmarkClicked"
                        HeightRequest="60"
                        BackgroundColor="Crimson"
                        TextColor="White"
                        FontSize="18"
                        CornerRadius="10"/>

                <Button x:Name="PrayerNotesButton"
                        Grid.Column="1"
                        Text="나의 기도 노트"
                        Clicked="OnPrayerNotesClicked"
                        HeightRequest="60"
                        BackgroundColor="#42a5f5"
                        TextColor="White"
                        FontSize="18"
                        CornerRadius="10"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>