<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="45" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <!-- StrokeShape을 RoundRectangle로 설정 -->
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>

        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />

        <!-- Stroke는 Brush 타입이므로 SolidColorBrush로 설정 -->
        <Setter Property="Stroke">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource PrimaryColor}" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>