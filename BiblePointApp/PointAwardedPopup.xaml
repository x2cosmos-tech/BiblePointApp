<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="BiblePointApp.PointAwardedPopup"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Grid BackgroundColor="#CC000000" VerticalOptions="Center" HorizontalOptions="Center">
        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                StrokeShape="RoundRectangle 20"
                Padding="30"
                WidthRequest="350"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="10">
            <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

                <Label Text="은혜 가득 포인트!" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#512BD4, Dark=#A294F9}" />

                <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="15" HorizontalOptions="Center">

                    <Image Grid.Column="0"
                           Source="point_coin.png"
                           WidthRequest="100"
                           HeightRequest="100"
                           Aspect="AspectFit"/>

                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label x:Name="PointValueLabel"
                               Text="+0" 
                               FontSize="36" 
                               FontAttributes="Bold"
                               TextColor="Gold" />
                        <Label Text="P"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Gold"
                               Margin="2,0,0,0"
                               VerticalOptions="End"/>
                    </HorizontalStackLayout>
                </Grid>

                <Label Text="필사를 완수하셨습니다." 
                       FontSize="16" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Label Text="하늘 나라 보화가 쌓였습니다!" 
                       FontSize="14" 
                       HorizontalOptions="Center"
                       TextColor="Gray" />

                <Button Text="확인"
                        Clicked="OnCloseButtonClicked"
                        BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#A294F9}"
                        TextColor="White"
                        HeightRequest="45"
                        CornerRadius="25"
                        Margin="0,15,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</toolkit:Popup>