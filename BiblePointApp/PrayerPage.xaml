<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="BiblePointApp.PrayerPage"
             Title="기도 노트">

    <Grid RowDefinitions="Auto, *" Padding="12" RowSpacing="15">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Entry Grid.Column="0"
                   x:Name="PrayerEntry"
                   Placeholder="기도 제목을 입력하세요..." />
            <Button Grid.Column="1"
                    x:Name="AddPrayerButton"
                    Text="추가"
                    Clicked="OnAddClicked" />
        </Grid>

        <CollectionView Grid.Row="1" x:Name="PrayerListView" ItemsSource="{Binding PrayerList}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,5" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=TwoWay}" CheckedChanged="OnCheckedChanged" VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                                <HorizontalStackLayout Spacing="15">
                                    <Label Text="{Binding StartDate, StringFormat='작성: {0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding AnswerDate, StringFormat='완료: {0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="Green"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Button Grid.Column="2" Text="❌" BackgroundColor="Transparent" TextColor="Red" WidthRequest="45" HeightRequest="45" VerticalOptions="Center" Clicked="OnDeleteClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="등록된 기도 제목이 없습니다." HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" Padding="30"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>