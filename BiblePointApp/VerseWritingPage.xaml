<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BiblePointApp.VerseWritingPage"
             Title="성경 필사">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="BgmToolbarItem" Text="🔊" Clicked="OnBgmToggleClicked" />
        <ToolbarItem Text="🏠 홈" Clicked="OnHomeToolbarClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView x:Name="MainScrollView">
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label x:Name="BookChapterLabel" FontSize="18" TextColor="Gray" HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Button x:Name="BookmarkButton" Grid.Column="0" Text="⭐ 책갈피 추가" Clicked="OnSaveBookmarkClicked" BackgroundColor="Gold" TextColor="Black" HeightRequest="45"/>
                <Button x:Name="MemorySaveButton" Grid.Column="1" Text="🔒 암기장 추가" Clicked="OnSaveToMemoryBookClicked" BackgroundColor="LightPink" TextColor="Black" HeightRequest="45"/>
            </Grid>

            <Label x:Name="CurrentVerseNumberLabel" Text="1절 필사 중" FontSize="20" FontAttributes="Bold" TextColor="#512BD4" Margin="0,10,0,0"/>
            <Label x:Name="InstructionLabel" Text="아래 구절 중에서 필사할 절을 선택하고 따라 적으세요." FontSize="14" TextColor="Gray" />

            <Border BackgroundColor="#F5F5F5" Padding="12" StrokeShape="RoundRectangle 5" StrokeThickness="0">
                <FlexLayout x:Name="GreyVerseLayout" Wrap="Wrap" HorizontalOptions="Start" VerticalOptions="Start" />
            </Border>

            <Border Stroke="#512BD4" StrokeThickness="1" StrokeShape="RoundRectangle 5" Padding="5">
                <Editor x:Name="WritingEntry"
                        Placeholder="여기에 필사하세요..."
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        AutoSize="TextChanges"
                        HeightRequest="100" 
                        TextChanged="OnTextChanged"
                        FontSize="18"
                        TextColor="Black" />
            </Border>

            <VerticalStackLayout Spacing="10" Margin="0,15,0,0">
                <BoxView HeightRequest="1" Color="LightGray" />
                <VerticalStackLayout x:Name="VerseListLayout" Spacing="10" Padding="0,5,0,30" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>